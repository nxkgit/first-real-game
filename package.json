{
  "name": "first-real-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "tsc && vitest run && vite build",
    "sim": "vite build --ssr src/sim/cli.ts --outDir .sim --emptyOutDir --logLevel warn && node .sim/cli.js",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.ts --coverage.exclude=src/scenes/** --coverage.exclude=src/dev/** --coverage.exclude=src/audio/** --coverage.exclude=src/**/*.test.ts --coverage.exclude=src/**/*.d.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
