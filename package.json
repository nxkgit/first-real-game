{
  "name": "first-real-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "tsc && tsc -p worker/tsconfig.json && vitest run && vite build",
    "worker:check": "tsc -p worker/tsconfig.json",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "sim": "vite build --ssr src/sim/cli.ts --outDir .sim --emptyOutDir --logLevel warn && node .sim/cli.js",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.ts --coverage.exclude=src/scenes/** --coverage.exclude=src/dev/** --coverage.exclude=src/audio/** --coverage.exclude=src/**/*.test.ts --coverage.exclude=src/**/*.d.ts",
    "balance": "vite build --ssr src/sim/balanceCli.ts --outDir .sim/balance --emptyOutDir --logLevel warn && node .sim/balance/balanceCli.js",
    "balance:baseline": "npm run balance -- baseline",
    "balance:check": "npm run balance -- check",
    "balance:evidence": "npm run balance -- evidence --out balance/reports/design-evidence/all",
    "balance:report": "npm run balance -- report --out balance/reports/sample",
    "content:check": "vite build --ssr src/content/checkCli.ts --outDir .sim/content --emptyOutDir --logLevel warn && node .sim/content/checkCli.js",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
